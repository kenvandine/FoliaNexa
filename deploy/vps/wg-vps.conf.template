# Reference only — this is the shape of config setup-wireguard.sh --role vps
# generates for you at /etc/wireguard/wg0.conf. Fill in by hand only if
# you'd rather not run the script; either way, keep the real file at
# mode 600 and never commit a real private key anywhere.
#
# One [Interface] section, but one [Peer] block PER HOME LXD HOST in the
# mesh — the script keeps each behind its own file under peers.d/ next to
# wg0.conf (peers.d/<peer-name>.conf) and concatenates them all into this
# file on every run, so adding/updating one host's entry never touches
# another's. Shown below: two home hosts, "node-a" and "node-b" — add or
# remove [Peer] blocks to match how many hosts you actually have.

[Interface]
Address = 10.66.0.1/24
PrivateKey = <VPS_WIREGUARD_PRIVATE_KEY>
ListenPort = 51820

[Peer]
# peer: node-a
# node-a's public key (from running setup-wireguard.sh --role home on
# node-a first).
PublicKey = <NODE_A_WIREGUARD_PUBLIC_KEY>
# Start with just this peer's own tunnel address. Once you know mgmt's
# real LAN address and node-a's LXD bridge subnet, add them here too —
# e.g. "10.66.0.2/32, 10.0.1.10/32, 10.0.1.0/24" — so the relocated
# folia-nexa-proxy can actually reach mgmt and world containers over the
# tunnel. Don't add node-a's own :8443 remote-API subnet — that must stay
# home-only (PLAN.md §3).
AllowedIPs = 10.66.0.2/32

[Peer]
# peer: node-b
PublicKey = <NODE_B_WIREGUARD_PUBLIC_KEY>
AllowedIPs = 10.66.0.3/32
# No Endpoint on any [Peer] block here: the VPS never dials out to home.
# Every home host has no forwarded port and a possibly-dynamic IP, so each
# is always the side that connects out and keeps its own NAT mapping alive
# via PersistentKeepalive on its own side (see wg-home.conf.template).
